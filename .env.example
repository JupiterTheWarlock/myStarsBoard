# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username_here

# OpenAI / AI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Tag Generation Settings
LANGUAGE=zh  # Language for generated tags: en (English) or zh (Chinese)
TAG_COUNT_MIN=3
TAG_COUNT_MAX=5
ENABLE_AI_TAGGING=false
ENABLE_NEW_TAGS=true
ENABLE_THINKING=false

# Processing Settings
BATCH_SIZE=5

# WebUI Configuration
# STARSBOARD_TITLE=My Stars
# STARSBOARD_FAVICON=⭐

# Vercel hosts the static keyword-search site; no model API credentials are needed there.
# The OpenAI settings above are only used by the tag-generation pipeline.
